package main

// The interface itself. This is the file to edit.
//
// Bubble Tea is the Elm architecture: state lives in one struct, every
// input arrives as a message, and Update returns the NEXT state rather
// than mutating the current one. View renders whatever state it is given
// and does nothing else - no I/O, no side effects. Work that blocks goes
// in a tea.Cmd, which runs off the event loop and reports back as
// another message.
//
// Note this is bubbletea v2, whose API differs from most examples
// online: Init returns only a tea.Cmd, View returns a tea.View rather
// than a string, key presses arrive as tea.KeyPressMsg, and alt-screen
// is a field on the View instead of a program option. v1 code will not
// compile here. See UPGRADE_GUIDE_V2.md in the bubbletea module.

import (
	"charm.land/bubbles/v2/key"
	"charm.land/bubbles/v2/list"
	tea "charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
)

// item is one row. list.Item needs these three methods; FilterValue is
// what `/` searches over.
type item struct {
	name string
	desc string
}

func (i item) Title() string       { return i.name }
func (i item) Description() string { return i.desc }
func (i item) FilterValue() string { return i.name }

// appStyle frames the whole interface. Its padding is subtracted from
// the window size before the list is sized, via GetFrameSize below -
// hardcoding the same numbers in two places is how a layout ends up one
// row too tall and scrolls its own help off screen.
var appStyle = lipgloss.NewStyle().Padding(1, 2)

type model struct {
	list list.Model
}

func newModel() model {
	items := []list.Item{
		item{name: "first", desc: "replace these with real data"},
		item{name: "second", desc: "see the Cmd note in Init"},
	}

	// Zero size, as the upstream list examples do. Bubble Tea reads the
	// terminal size at startup and delivers a WindowSizeMsg BEFORE the
	// first render, so the real dimensions always arrive before anything
	// is drawn and a placeholder size would only ever be wrong.
	l := list.New(items, list.NewDefaultDelegate(), 0, 0)
	l.Title = "{{ .Name }}"

	// q is handled in Update, so the list does not know about it; without
	// this the help line never mentions how to leave.
	l.AdditionalShortHelpKeys = func() []key.Binding {
		return []key.Binding{
			key.NewBinding(key.WithKeys("q"), key.WithHelp("q", "quit")),
		}
	}

	return model{list: l}
}

// Init runs once, before the first render. Return a tea.Cmd here to do
// startup work - loading from a file or an API - and handle the message
// it produces in Update. Returning nil means "nothing to do".
func (m model) Init() tea.Cmd {
	return nil
}

// Update handles one message and returns the next state. It must not
// block: anything slow belongs in a tea.Cmd.
func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		// Subtract the frame appStyle adds, so the list fills exactly
		// what is left rather than overflowing by the padding.
		h, v := appStyle.GetFrameSize()
		m.list.SetSize(msg.Width-h, msg.Height-v)
		return m, nil

	case tea.KeyPressMsg:
		// While the filter is open, every key belongs to it - including
		// "q". Checking this first is what stops typing a name that
		// contains q from quitting the program.
		if m.list.FilterState() == list.Filtering {
			break
		}
		switch msg.String() {
		case "q", "ctrl+c":
			return m, tea.Quit
		}
	}

	// Anything not handled above goes to the list: arrows, page keys,
	// the filter. Returning its Cmd is what keeps its spinner and
	// filtering working.
	var cmd tea.Cmd
	m.list, cmd = m.list.Update(msg)
	return m, cmd
}

// View renders the current state. Pure: no state changes, no I/O.
//
// No help line is added here: list.Model draws its own, generated from
// its real keybindings, and a second hand-written one beside it says the
// same things twice and drifts the moment a binding changes.
func (m model) View() tea.View {
	v := tea.NewView(appStyle.Render(m.list.View()))
	// Draw on the terminal's alternate buffer, so the shell's scrollback
	// is untouched and whatever the user had on screen comes back when
	// the program exits. In v2 this is a field on the View rather than a
	// program option.
	v.AltScreen = true
	return v
}

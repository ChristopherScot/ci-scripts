{
  "compilerOptions": {
    // Nothing is emitted. Node runs these files directly by stripping
    // the types at load time, so there is no dist/ and tsc's only job
    // is to check.
    "noEmit": true,

    // nodenext, because that is what Node's own resolver does.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",

    // Type stripping ERASES types rather than compiling them, so
    // anything needing code generation does not work at runtime: enums,
    // namespaces, parameter properties, experimental decorators. These
    // two make tsc reject them here rather than letting them reach a
    // runtime that cannot execute them.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // Imports name the file Node will actually open - './server.ts' -
    // so tsc has to accept the extension rather than insisting on the
    // '.js' a compiler would have emitted.
    "allowImportingTsExtensions": true,

    "strict": true,
    // Skips the dependency tree's own .d.ts files, which are slow to
    // check and not ours to fix. The generated API client's types are
    // still checked at every call site, which is the point.
    "skipLibCheck": true
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}

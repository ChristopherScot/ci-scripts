import { createServer } from 'node:http'
import pino from 'pino'

const port = process.env.PORT || '{{ .Port }}'
const started = Date.now()

// Configured to match what go-service's slog emits, so one Loki query
// works against either runtime: an ISO-8601 `time`, an uppercase `level`
// name rather than pino's numeric default, and `msg`. Without these
// formatters the two runtimes describe the same events differently.
//
// The bindings put service, team and version on every line. Alloy adds
// pod and namespace labels in Loki, but a line copied into a ticket, an
// alert or a terminal arrives without them - and "shutting down" from an
// unnamed service is not worth much. VERSION is stamped by CI; it is
// "dev" for a local run.
const log = pino({
  level: process.env.LOG_LEVEL || 'info',
  base: {
    service: '{{ .Name }}',
    team: '{{ .Team }}',
    version: process.env.VERSION || 'dev',
  },
  timestamp: () => `,"time":"${new Date().toISOString()}"`,
  formatters: {
    level: (label) => ({ level: label.toUpperCase() }),
  },
})

// The deployment annotates this pod for scraping at /metrics. Without a
// handler here Alloy would scrape the catch-all, get a 200, and fail to
// parse the body - which reads as a data problem rather than a missing
// endpoint. Minimal exposition rather than a dependency; swap in prom-client
// when this service has metrics worth naming.
function metrics() {
  const up = Math.floor((Date.now() - started) / 1000)
  return [
    '# HELP process_uptime_seconds Seconds since process start.',
    '# TYPE process_uptime_seconds gauge',
    `process_uptime_seconds ${up}`,
    '# HELP nodejs_heap_used_bytes Heap in use.',
    '# TYPE nodejs_heap_used_bytes gauge',
    `nodejs_heap_used_bytes ${process.memoryUsage().heapUsed}`,
    '',
  ].join('\n')
}

const server = createServer((req, res) => {
  if (req.url === '/healthz') {
    res.writeHead(200).end('ok\n')
    return
  }
  if (req.url === '/metrics') {
    res.writeHead(200, { 'Content-Type': 'text/plain; version=0.0.4' }).end(metrics())
    return
  }
  res.writeHead(200).end('{{ .Name }}\n')
})

server.listen(port, '0.0.0.0', () => {
  log.info({ addr: ':' + port }, 'started')
})

// Without this, SIGTERM kills in-flight requests on every deploy.
for (const sig of ['SIGTERM', 'SIGINT']) {
  process.on(sig, () => {
    log.info('shutting down')
    server.close(() => process.exit(0))
  })
}

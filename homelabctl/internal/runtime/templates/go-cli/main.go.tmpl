// {{ .Name }}
package main

import (
	"fmt"
	"os"
)

// Version is set at build time via ldflags; "dev" for local builds, which
// deliberately refuse to self-update.
var Version = "dev"

func main() {
	if len(os.Args) < 2 {
		usage()
		os.Exit(1)
	}
	var err error
	switch os.Args[1] {
	case "update":
		err = runUpdate(os.Args[2:])
	case "version":
		fmt.Println(Version)
	case "-h", "--help", "help":
		usage()
	default:
		fmt.Fprintf(os.Stderr, "unknown command %q\n\n", os.Args[1])
		usage()
		os.Exit(1)
	}
	if err != nil {
		fmt.Fprintln(os.Stderr, "error: "+err.Error())
		os.Exit(1)
	}
}

func usage() {
	fmt.Fprint(os.Stderr, `{{ .Name }}

  update [--check]   update this binary to the latest release
  version            print the version
`)
}

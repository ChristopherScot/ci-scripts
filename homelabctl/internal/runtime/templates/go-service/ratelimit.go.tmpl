// Rate limiting, and telling the caller enough to behave well.
//
// A 429 with no Retry-After is worse than no limit at all: a client that
// retries gets to choose when, and a client written by someone else will
// choose badly. Answering with Retry-After moves the decision to the side
// that knows - and the generated clients honour it, so a caller that
// imports this service's client backs off correctly without writing any
// code.
//
// Off by default. A service behind the LAN ingress with one caller does
// not need it, and a limiter that nobody tuned rejects real traffic.
//
// PER POD, NOT PER SERVICE. The buckets are in memory, so N replicas
// allow N times the configured rate. That is fine for protecting a pod
// from one abusive caller - each pod defends itself - and wrong for
// enforcing a quota, because the total depends on how many replicas
// happen to be running. A quota needs shared state (Redis, or a proxy in
// front like Clever's sphinx); this deliberately does not have it, since
// a rate limiter that can fail to reach Redis is a new way for the
// service to fall over.
//
// Set the limit per POD accordingly: `replicas: 3` with RATE_LIMIT_RPS=10
// admits 30/s in the worst case.

// Policy is a sustained rate and the burst allowed above it.
type Policy struct {
	Rate  float64 // requests per second
	Burst float64 // idle credit, so how large a spike passes
}

// Limiter is a token bucket per caller, per operation.
//
// Per operation because endpoints are not equally expensive: a read that
// hits a cache and a write that fans out to three services should not
// share a budget. The operation ID comes from the spec, so a limit cannot
// drift from the route it governs the way a path regex can.
type Limiter struct {
	// Default applies to any operation without its own entry.
	Default Policy

	// PerOperation overrides Default, keyed by the spec's operationId.
	PerOperation map[string]Policy

	mu      sync.Mutex
	buckets map[string]*bucket
	now     func() time.Time // swappable for tests
}

type bucket struct {
	tokens float64
	last   time.Time
}

func NewLimiter(rate, burst float64) *Limiter {
	return &Limiter{
		Default:      Policy{Rate: rate, Burst: burst},
		PerOperation: map[string]Policy{},
		buckets:      map[string]*bucket{},
		now:          time.Now,
	}
}

// For sets a limit for one operation, overriding the default.
//
//	limiter().For("createThing", Policy{Rate: 1, Burst: 2})
func (l *Limiter) For(operationID string, p Policy) *Limiter {
	l.PerOperation[operationID] = p
	return l
}

// policy returns the limit governing an operation.
func (l *Limiter) policy(operationID string) Policy {
	if p, ok := l.PerOperation[operationID]; ok {
		return p
	}
	return l.Default
}

// allow spends a token for one caller on one operation. When none is
// available it reports how long the caller must wait, which is what
// Retry-After carries.
func (l *Limiter) allow(caller, operationID string) (bool, time.Duration) {
	p := l.policy(operationID)
	k := caller + "\x00" + operationID

	l.mu.Lock()
	defer l.mu.Unlock()

	now := l.now()
	b, ok := l.buckets[k]
	if !ok {
		b = &bucket{tokens: p.Burst, last: now}
		l.buckets[k] = b
	}

	// Refill for the time since the last request, capped at Burst.
	b.tokens += now.Sub(b.last).Seconds() * p.Rate
	if b.tokens > p.Burst {
		b.tokens = p.Burst
	}
	b.last = now

	if b.tokens >= 1 {
		b.tokens--
		return true, 0
	}

	// Retry-After is whole seconds, and rounding DOWN would invite a
	// retry that is still too early - so round up, minimum one second.
	wait := time.Duration((1-b.tokens)/p.Rate*float64(time.Second)) + time.Second - 1
	if wait < time.Second {
		wait = time.Second
	}
	return false, wait
}

// remaining reports the tokens left, for RateLimit-Remaining.
func (l *Limiter) remaining(caller, operationID string) int {
	l.mu.Lock()
	defer l.mu.Unlock()
	b, ok := l.buckets[caller+"\x00"+operationID]
	if !ok {
		return int(l.policy(operationID).Burst)
	}
	if b.tokens < 0 {
		return 0
	}
	return int(b.tokens)
}

// key identifies the caller by IP.
//
// X-Forwarded-For first: every request arrives from the ingress
// controller, so RemoteAddr would be one bucket for the whole cluster and
// one noisy caller would rate-limit everyone.
//
// The port must be stripped. RemoteAddr is host:port and the port is
// ephemeral, so keying on it gives every CONNECTION its own bucket - a
// per-client limit that never limits, which is what this did until a test
// caught it.
func key(r *http.Request) string {
	if f := r.Header.Get("X-Forwarded-For"); f != "" {
		// Left-most is the original client; the rest are proxies.
		if i := strings.IndexByte(f, ','); i >= 0 {
			f = f[:i]
		}
		return strings.TrimSpace(f)
	}
	if host, _, err := net.SplitHostPort(r.RemoteAddr); err == nil {
		return host
	}
	return r.RemoteAddr
}

// router is what a rate limiter needs from the generated server: which
// operation a request would reach. Satisfied by *api.Server.
type router interface {
	FindRoute(method, path string) (api.Route, bool)
}

// rateLimit rejects requests over the limit with 429 and the headers a
// caller needs to back off correctly.
//
// This is HTTP middleware rather than ogen middleware, and that is
// forced: ogen's middleware.Response carries only a response type and
// its error path only a status and body, so neither can set Retry-After
// - which is the entire point. Instead it asks the generated router
// which operation the request would reach, and keeps control of the
// response.
//
// A request matching no operation is not limited: it is about to 404, and
// creating a bucket for it would let an unrouted path fill memory.
//
// Retry-After (RFC 9110) is the header that matters - stable, and both
// generated clients honour it in preference to their own backoff.
// RateLimit-* are advisory, since the IETF field is still a draft, so
// these follow the widely deployed de-facto names.
func rateLimit(l *Limiter, r router, next http.Handler) http.Handler {
	if l == nil {
		return next
	}
	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		route, ok := r.FindRoute(req.Method, req.URL.Path)
		if !ok {
			next.ServeHTTP(w, req)
			return
		}
		op := route.OperationID()

		// The kubelet probes /healthz as often as every few seconds;
		// limiting it lets a busy pod be restarted for being busy.
		if op == "getHealthz" {
			next.ServeHTTP(w, req)
			return
		}

		caller := key(req)
		allowed, wait := l.allow(caller, op)
		p := l.policy(op)

		w.Header().Set("RateLimit-Limit", strconv.Itoa(int(p.Burst)))
		w.Header().Set("RateLimit-Remaining", strconv.Itoa(l.remaining(caller, op)))

		if !allowed {
			secs := int(wait.Seconds())
			w.Header().Set("Retry-After", strconv.Itoa(secs))
			w.Header().Set("RateLimit-Reset", strconv.Itoa(secs))
			rateLimited.WithLabelValues(op).Inc()
			http.Error(w, "rate limit exceeded", http.StatusTooManyRequests)
			return
		}
		next.ServeHTTP(w, req)
	})
}

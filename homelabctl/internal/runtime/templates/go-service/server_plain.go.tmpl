package main

// Everything in this file knows what this service serves. main.go does
// not: it calls handler() and starts whatever comes back.
//
// This is the specless variant, scaffolded by `homelabctl init --no-spec`
// for a service whose shape OpenAPI cannot usefully express - a reverse
// proxy, a websocket endpoint, anything that redirects or serves HTML, or
// anything wanting a catch-all route. There is no openapi.yml, no
// generated api/ package and no clients.
//
// This file is YOURS to edit. main.go, the Dockerfile, CI and every
// manifest are the template's and stay as generated, so a later
// convention change still reaches this service.
//
// Two things below are load-bearing rather than decorative:
//
//   - /health exists here because nothing else creates it. With a spec it
//     is a documented path the generated router serves; without one, this
//     handler is the only thing standing between the manifest's
//     readinessProbe and a pod that never becomes ready.
//   - metrics are labelled by ROUTE PATTERN, never by request path. A
//     generated router rejects unrouted requests before they can become a
//     label; here, nothing does, so a path used as a label is unbounded
//     cardinality and writes caller-controlled strings into the
//     monitoring stack.

import (
	"encoding/json"
	"log/slog"
	"net/http"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promauto"
	"github.com/prometheus/client_golang/prometheus/promhttp"
	"golang.org/x/mod/semver"
)

var (
	requests = promauto.NewCounterVec(prometheus.CounterOpts{
		Name: "http_requests_total",
		Help: "Requests by route, method and status.",
	}, []string{"route", "method", "status"})

	latency = promauto.NewHistogramVec(prometheus.HistogramOpts{
		Name:    "http_request_duration_seconds",
		Help:    "Request latency by route and method.",
		Buckets: prometheus.DefBuckets,
	}, []string{"route", "method"})
)

// statusRecorder captures the status code, which http.ResponseWriter
// does not expose after the fact.
type statusRecorder struct {
	http.ResponseWriter
	status int
}

func (r *statusRecorder) WriteHeader(code int) {
	r.status = code
	r.ResponseWriter.WriteHeader(code)
}

// observe logs and measures one route. It takes the route name as an
// argument rather than reading the request path, so a label can only ever
// be a string written in this file.
func observe(route string, next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, req *http.Request) {
		// Refused before the handler runs: a client below the floor is
		// one whose requests are the problem, so serving it is the
		// thing being prevented.
		//
		// 410 Gone, not 429: the generated clients retry 429 and 5xx
		// and nothing else, so 410 stops them dead. A status they
		// retried would turn one stuck client into a storm.
		if tooOld(req) {
			slog.Warn("refusing a client below the floor",
				"route", route,
				"client", clientName(req),
				"client_version", req.Header.Get(ClientVersionHeader),
				"min_version", minVersion)
			http.Error(w, "this client is too old; reload or upgrade", http.StatusGone)
			return
		}

		start := time.Now()
		rec := &statusRecorder{ResponseWriter: w, status: http.StatusOK}
		next(rec, req)

		elapsed := time.Since(start)
		status := strconv.Itoa(rec.status)
		requests.WithLabelValues(route, req.Method, status).Inc()
		latency.WithLabelValues(route, req.Method).Observe(elapsed.Seconds())

		slog.Info("request",
			"method", req.Method,
			"route", route,
			"status", rec.status,
			// WHO called, from the headers every generated client
			// sends. Without it every request line looks identical
			// whoever sent it, so a runaway client cannot be
			// attributed without inference.
			"client", clientName(req),
			"client_version", req.Header.Get(ClientVersionHeader),
			// Float milliseconds, not elapsed.Milliseconds(): that truncates to
			// an integer, and a handler serving from memory finishes well under
			// 1ms. Every line logged duration_ms=0, so the field was present and
			// carried nothing - a latency panel built on it reads flat zero
			// whether the service is fast or dying.
			"duration_ms", float64(elapsed.Nanoseconds())/1e6)
	}
}

// Header names the generated clients send. Declared here so the server
// does not depend on the client package to read its own requests.
//
// No X- prefix: RFC 6648 deprecated it in 2012.
const (
	ClientNameHeader    = "Client-Name"
	ClientVersionHeader = "Client-Version"
)

// minVersion is the oldest client this service answers, from
// MIN_VERSION in the environment. Empty means no floor, which is the
// normal state: the check is inert until someone raises it.
//
// Read at startup rather than compiled in, so raising the floor is a
// config.yaml edit and a restart. That matters because the floor is
// raised in response to a client actively causing harm, and a rebuild
// is the slowest possible way to respond to that.
var minVersion = os.Getenv("MIN_VERSION")

// tooOld reports whether a caller is below the floor.
//
// Both sides are compared as semver with the leading v that
// golang.org/x/mod/semver requires. Clients report a BARE version -
// openapi.yml's info.version for Go, package.json's for TypeScript,
// and npm forbids the prefix - so the v is added here rather than
// expected on the wire. The VERSION files that do carry one drive
// release tags and never reach this header.
//
// FAILS OPEN on anything it cannot parse, and on a caller that sends no
// version at all. Those are curl, a probe, a script - not the stale
// client this exists to stop - and refusing them would break far more
// than it fixed.
func tooOld(r *http.Request) bool {
	if minVersion == "" {
		return false
	}
	got := r.Header.Get(ClientVersionHeader)
	if got == "" {
		return false
	}
	got, floor := "v"+got, "v"+strings.TrimPrefix(minVersion, "v")
	if !semver.IsValid(got) || !semver.IsValid(floor) {
		return false
	}
	return semver.Compare(got, floor) < 0
}

// clientName is which service sent a request.
//
// "unknown" when the caller sends no header, rather than sniffed from
// the user agent: an honest gap beats a confident wrong attribution,
// and anything not built from a generated client is genuinely unknown.
func clientName(r *http.Request) string {
	if n := r.Header.Get(ClientNameHeader); n != "" {
		return n
	}
	return "unknown"
}

// writeJSON keeps the Content-Type and the encoding in one place.
func writeJSON(w http.ResponseWriter, code int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	if err := json.NewEncoder(w).Encode(v); err != nil {
		slog.Error("writing response", "err", err)
	}
}

func handler() (http.Handler, error) {
	mux := http.NewServeMux()

	// What the manifest's readiness and liveness probes hit. Deleting
	// this makes the pod fail to become ready with no error that names
	// the cause.
	//
	// Deliberately NOT wrapped in observe: the kubelet hits it every few
	// seconds, which would bury real traffic in the logs and fill the
	// counters with self-observation.
	mux.HandleFunc("GET /health", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
	})

	// The deployment annotates this pod for scraping here; without this
	// handler the annotation points at a 404.
	mux.Handle("GET /metrics", promhttp.Handler())

	mux.HandleFunc("GET /{$}", observe("root", func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, map[string]string{
			"service": "{{ .Name }}",
			"version": version,
		})
	}))

	return mux, nil
}
